# Copy to .env and replace every placeholder. Never commit .env.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
ALLOWED_USER_IDS=REPLACE_WITH_YOUR_NUMERIC_TELEGRAM_ID
TIMEZONE=Asia/Seoul
SUPABASE_URL=https://REPLACE_WITH_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_REFRESH_TOKEN=REPLACE_WITH_GOOGLE_REFRESH_TOKEN
GOOGLE_CALENDAR_ID=primary
BOT_MODE=polling
# Set BOT_MODE=webhook and this public HTTPS base URL on Northflank.
WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_A_RANDOM_WEBHOOK_SECRET
DIALOG_TTL_SECONDS=1800
PORT=8080
